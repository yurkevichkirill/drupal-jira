{#
/**
 * @file
 * Theme override for the "text" paragraph type.
 *
 * Available variables (in addition to the defaults):
 * - paragraph_bundle_class: computed in drupal_jira_preprocess_paragraph().
 * - text_word_count: number of words in field_body.
 * - text_reading_time: estimated reading time in minutes.
 */
#}
<article{{ attributes.addClass('paragraph', 'paragraph-text', paragraph_bundle_class) }}>
  <div class="paragraph-text__meta" data-words="{{ text_word_count }}">
    {{ 'Reading time: @minutes min'|t({'@minutes': text_reading_time}) }}
  </div>
  <div class="paragraph-text__body">{{ content.field_body }}</div>
</article>
