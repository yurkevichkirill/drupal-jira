{#
/**
 * @file
 * Project list page (the `projects` view): a grid of project cards, styled
 * after the same tokens as the Kanban board and project-stats cards rather
 * than core's bare views markup.
 *
 * @see views-view-fields--projects.html.twig
 * @see template_preprocess_views_view()
 */
#}
{{ attach_library('drupal_jira/entity_list') }}
{%
  set classes = [
    'entity-list',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% if header %}
    <header>{{ header }}</header>
  {% endif %}

  <div class="entity-list__toolbar">
    {{ exposed }}
    <a href="{{ path('node.add', {'node_type': 'project'}) }}" class="entity-list__new">{{ '+ New project'|t }}</a>
  </div>

  {{ attachment_before }}

  {% if rows -%}
    <div class="project-grid">
      {{ rows }}
    </div>
  {% elseif empty -%}
    <p class="entity-list__empty">{{ empty }}</p>
  {% endif %}

  <div class="entity-list__pager">{{ pager }}</div>

  {{ attachment_after }}
  {{ more }}

  {% if footer %}
    <footer>{{ footer }}</footer>
  {% endif %}

  {{ feed_icons }}
</div>
