{#
/**
 * @file
 * Theme override for the "image" paragraph type.
 *
 * Available variables (in addition to the defaults):
 * - paragraph_bundle_class: computed in drupal_jira_preprocess_paragraph().
 * - image_has_media: TRUE when field_image references a media entity.
 */
#}
<figure{{ attributes.addClass('paragraph', 'paragraph-image', paragraph_bundle_class) }}>
  {% if image_has_media %}
    <div class="paragraph-image__media">{{ content.field_image }}</div>
  {% endif %}
</figure>
